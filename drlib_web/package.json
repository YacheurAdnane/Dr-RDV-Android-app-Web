{
  "name": "drlib-web",
  "version": "1.0.0",
  "private": true,
  "description": "Web (PWA) version of the DRlib RDV appointment watcher, running on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-tz.mjs && node scripts/test-push.mjs",
    "vapid": "node scripts/gen-vapid.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "db:init": "wrangler d1 execute drlib --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute drlib --local --file=./schema.sql",
    "admin": "node scripts/make-admin.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.135.0"
  }
}
