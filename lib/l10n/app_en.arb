  "frequencyTitle": "How often to search?",
  "searchEvery": "I search {interval}",
  "frequencyBody": "Android never runs a check more often than every 15 minutes, and may delay it while the phone sleeps. \"More often\" means \"as soon as possible\", not \"to the second\".",
  "freq15Advice": "Every 15 minutes is the minimum Android allows, not necessarily the best: it uses four times the requests of 60 minutes for a small real gain, since the system delays tasks while the phone sleeps anyway. Keep it for a truly urgent search over a few days.",
  "freqBalancedAdvice": "Good balance: quick enough to catch a cancellation, light enough to run for weeks.",
  "freqSlowAdvice": "Very frugal. Suits a long-running search where slots do not vanish within minutes.",
  "allowBackground": "Allow the app in the background",
  "allowBackgroundBody": "Without it, Android puts the app to sleep and checks stop. It is the number one cause of alerts that never ring.",
  "backgroundRestricted": "Still restricted: open Android settings",
  "quietOnBody": "Between {from} and {to} the app searches nothing and never rings, not even a \"Call me\" alert.",
  "quietOffBody": "The app searches and may ring at any time",
  "fromLabel": "From",
  "toLabel": "to",
  "notifications": "Notifications",
  "groupByAlert": "Group by alert",
  "groupByAlertBody": "A single notification summing up all new slots, rather than one per slot.",
  "statusBadge": "Permanent monitoring badge",
  "statusBadgeBody": "Keeps a silent line in the notification shade, like an antivirus: each alert's state, free slots and the time of the last search. The best way to see at a glance that the app is still running.",
  "needAndroid13": "Required on Android 13 and later",
  "notifRefused": "Denied: turn them on in Android settings",
  "testAlert": "Test an alert",
  "testAlertBody": "Hear what each style sounds like before trusting it with a real appointment.",
  "sampleSent": "Sample sent: {label}",
  "callModeTitle": "\"Call me\" mode",
  "callModeBody": "The phone rings until you answer. The green button opens the appointment on Doctolib directly. The red button, or no answer, stops the ringing and leaves a regular notification: the slot stays one tap away.",
  "soundBundled": "Bundled with the app",
  "soundSystem": "The one set on your phone",
  "listen": "Listen",
  "testCallSent": "Test call: {label} (12 s, try both buttons)",
  "ringDuration": "Ringing duration",
  "ringDurationBody": "With no answer after {s} s, the call stops and a \"missed call\" notification replaces it.",
  "blockTitle": "Avoid being blocked",
  "blockBody": "Doctolib watches phones that ask too many questions and ends up ignoring them for a while. These settings keep the app well below that line: few requests, well spaced, and it backs off on its own if the site pushes back.",
  "frugalTitle": "Frugal mode (recommended)",
  "frugalBody": "Only asks for exact times for practitioners not already spotted: a search then costs 1 to 3 requests instead of about twenty. This is what protects you most from being blocked.",
  "safetyLimit": "Safety limit: {label}",
  "safetyLimitBody": "At most {max} requests to Doctolib a day, across all alerts. Past this limit, the app stops until the next day rather than risk a block. Today: {today} used.",
  "estimate": "Estimate",
  "estimateBody": "You search {interval}, {quiet}. That is about {perRun} request(s) to Doctolib each time, roughly {perDay} a day out of a limit of {max}.",
  "overLimit": "That is above your limit: search less often, extend quiet hours, or keep fewer alerts active.",
  "safetyPause": "Safety pause",
